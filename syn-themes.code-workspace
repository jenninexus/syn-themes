{
	"folders": [
		{
			"path": "."
		},
		{
			"path": "../vid-scroll"
		}
	],
	"settings": {
		"workbench.colorTheme": "Dark 2026",
		"workbench.colorCustomizations": {
			"activityBar.background": "#10313C",
			"titleBar.activeBackground": "#174555",
			"titleBar.activeForeground": "#F6FBFD"
		}
	},
	"tasks": {
		"version": "2.0.0",
		"tasks": [
			{
				"label": "Package Extension",
				"type": "shell",
				"command": "npx @vscode/vsce package --no-dependencies",
				"group": "build",
				"problemMatcher": []
			},
			{
				"label": "Publish Extension (VS Code)",
				"type": "shell",
				"command": "npx @vscode/vsce publish --pat $env:VSCE_PAT",
				"group": "build",
				"problemMatcher": []
			},
			{
				"label": "Publish Open VSX (Cursor)",
				"type": "shell",
				"command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/publish-openvsx.ps1",
				"group": "build",
				"problemMatcher": []
			},
			{
				"label": "Generate Swatches",
				"type": "shell",
				"command": "node storage/tools/generate-swatches.mjs",
				"group": "build",
				"problemMatcher": []
			}
		]
	},
	"launch": {
		"version": "0.2.0",
		"configurations": [
			{
				"name": "Extension Development Host",
				"type": "extensionHost",
				"request": "launch",
				"args": ["--extensionDevelopmentPath=${workspaceFolder}"]
			}
		]
	}
}

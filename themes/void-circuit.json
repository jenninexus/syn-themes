    "list.inactiveSelectionBackground": "#9b7cff12",
    "list.hoverBackground": "#0c0c1a",
    "list.focusBackground": "#9b7cff18",
    "list.highlightForeground": "#4ae8e8",
    "statusBar.background": "#050508",
    "statusBar.foreground": "#4ae8e8",
    "statusBar.border": "#0e0e1a",
    "statusBar.debuggingBackground": "#9b7cff",
    "statusBar.debuggingForeground": "#050508",
    "statusBar.noFolderBackground": "#050508",
    "statusBarItem.hoverBackground": "#9b7cff22",
    "statusBarItem.remoteBackground": "#9b7cff",
    "statusBarItem.remoteForeground": "#050508",
    "panel.background": "#06060b",
    "panel.border": "#1a1a2e",
    "panelTitle.activeBorder": "#9b7cff",
    "panelTitle.activeForeground": "#d0d0e8",
    "panelTitle.inactiveForeground": "#7070a0",
    "terminal.background": "#050508",
    "terminal.foreground": "#d0d0e8",
    "terminal.ansiBlack": "#1a1a2e",
    "terminal.ansiRed": "#ff6b8a",
    "terminal.ansiGreen": "#3ee8b8",
    "terminal.ansiYellow": "#e4c85a",
    "terminal.ansiBlue": "#6b9aff",
    "terminal.ansiMagenta": "#9b7cff",
    "terminal.ansiCyan": "#4ae8e8",
    "terminal.ansiWhite": "#d0d0e8",
    "terminal.ansiBrightBlack": "#3a3a5e",
    "terminal.ansiBrightRed": "#ff7898",
    "terminal.ansiBrightGreen": "#5aeac0",
    "terminal.ansiBrightYellow": "#f0da78",
    "terminal.ansiBrightBlue": "#78a8ff",
    "terminal.ansiBrightMagenta": "#a88aff",
    "terminal.ansiBrightCyan": "#5aeaea",
    "terminal.ansiBrightWhite": "#eaeaf8",
    "terminalCursor.foreground": "#4ae8e8",
    "input.background": "#0a0a14",
    "input.foreground": "#d0d0e8",
    "input.border": "#1a1a2e",
    "input.placeholderForeground": "#636383",
    "inputOption.activeBorder": "#9b7cff",
    "dropdown.background": "#0a0a14",
    "dropdown.foreground": "#d0d0e8",
    "dropdown.border": "#1a1a2e",
    "button.background": "#9b7cff",
    "button.foreground": "#050508",
    "button.hoverBackground": "#ad90ff",
    "button.secondaryBackground": "#1a1a2e",
    "button.secondaryForeground": "#d0d0e8",
    "badge.background": "#9b7cff",
    "badge.foreground": "#050508",
    "scrollbar.shadow": "#00000040",
    "scrollbarSlider.background": "#9b7cff18",
    "scrollbarSlider.hoverBackground": "#9b7cff30",
    "scrollbarSlider.activeBackground": "#9b7cff44",
    "breadcrumb.foreground": "#7878a8",
    "breadcrumb.focusForeground": "#d0d0e8",
    "breadcrumb.activeSelectionForeground": "#9b7cff",
    "breadcrumbPicker.background": "#0a0a14",
    "gitDecoration.addedResourceForeground": "#3ee8b8",
    "gitDecoration.modifiedResourceForeground": "#9b7cff",
    "gitDecoration.deletedResourceForeground": "#ff6b8a",
    "gitDecoration.untrackedResourceForeground": "#4ae8e8",
    "gitDecoration.ignoredResourceForeground": "#5a5a6e",
    "gitDecoration.conflictingResourceForeground": "#e4c85a",
    "minimap.selectionHighlight": "#9b7cff44",
    "minimap.findMatchHighlight": "#4ae8e844",
    "peekView.border": "#9b7cff44",
    "peekViewEditor.background": "#08080e",
    "peekViewResult.background": "#08080e",
    "peekViewTitle.background": "#0a0a14",
    "notifications.background": "#0a0a14",
    "notifications.foreground": "#d0d0e8",
    "notifications.border": "#1a1a2e",
    "commandCenter.background": "#08080e",
    "commandCenter.foreground": "#d0d0e8",
    "commandCenter.border": "#1a1a2e"
  },
  "semanticTokenColors": {
    "function.declaration": "#5ac8f0",
    "function.defaultLibrary": "#6b9aff",
    "variable.readonly": "#c0a8f0",
    "variable.defaultLibrary": "#e4c85a",
    "property.readonly": "#6b9aff",
    "type.defaultLibrary": "#e4c85a",
    "class": "#e4c85a",
    "interface": "#4ae8e8",
    "enum": "#e4c85a",
    "enumMember": "#f0a060",
    "namespace": "#9b7cff",
    "decorator": "#e4c85a",
    "parameter.declaration": "#c0a8f0",
    "typeParameter": "#4ae8e8",
    "*.modification": {
      "fontStyle": "underline"
    },
    "*.async": {
      "fontStyle": "italic"
    },
    "function.declaration:tsx": "#5ac8f0",
    "function.declaration:typescriptreact": "#5ac8f0",
    "variable.readonly.defaultLibrary": "#e4c85a"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#797991",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#3ee8b8"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#e4c85a"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#f0a060"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#9b7cff"
      }
    },
    {
      "name": "Control flow",
      "scope": [
        "keyword.control",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#a88aff"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#4ae8e8"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#5ac8f0"
      }
    },
    {
      "name": "Classes & Types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#e4c85a"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#4ae8e8"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#d0d0e8"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#c0a8f0"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#6b9aff"
      }
    },
    {
      "name": "Tags (HTML/JSX)",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#ff6b8a"
      }
    },
    {
      "name": "Tag attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#e4c85a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#4ae8e8"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#6b9aff"
      }
    },
    {
      "name": "CSS values",
      "scope": [
        "support.constant.property-value.css",
        "meta.property-value.css"
      ],
      "settings": {
        "foreground": "#d0d0e8"
      }
    },
    {
      "name": "SCSS variables",
      "scope": [
        "variable.scss",
        "variable.css"
      ],
      "settings": {
        "foreground": "#c0a8f0"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#f0a060"
      }
    },
    {
      "name": "Escape characters",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#4ae8e8"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#7f7fa4"
      }
    },
    {
      "name": "JSON keys",
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#6b9aff"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#9b7cff",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#eaeaf8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#c0a8f0",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#4ae8e8"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#3ee8b8"
      }
    },
    {
      "name": "PHP tags",
      "scope": [
        "punctuation.section.embedded.begin.php",
        "punctuation.section.embedded.end.php"
      ],
      "settings": {
        "foreground": "#ff6b8a"
      }
    },
    {
      "name": "PHP variables",
      "scope": [
        "variable.other.php"
      ],
      "settings": {
        "foreground": "#c0a8f0"
      }
    },
    {
      "name": "YAML keys",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#6b9aff"
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#e4c85a"
      }
    },
    {
      "name": "This / Self",
      "scope": [
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#ff6b8a",
        "fontStyle": "italic"
      }
    }
  ]
}

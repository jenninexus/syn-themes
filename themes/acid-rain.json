    "notifications.background": "#080e0c",
    "notifications.foreground": "#c8dcd0",
    "notifications.border": "#102018"
  },
  "semanticTokenColors": {
    "function.declaration": "#5ab8d8",
    "function.defaultLibrary": "#22d3a8aa",
    "variable.readonly": "#a8c8bc",
    "variable.defaultLibrary": "#c8b030",
    "property.readonly": "#8ab8a8",
    "type.defaultLibrary": "#c8b030",
    "class": "#9878d8",
    "interface": "#22d3a8",
    "enum": "#9878d8",
    "enumMember": "#d86840",
    "namespace": "#00e8a0",
    "decorator": "#c8b030",
    "parameter.declaration": "#b098e8",
    "typeParameter": "#22d3a8",
    "*.modification": { "fontStyle": "underline" },
    "*.async": { "fontStyle": "italic" },
    "variable.readonly.defaultLibrary": "#c8b030"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#2e4438", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#00e8a0" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#c8b030" } },
    { "scope": ["constant.language", "constant.other"], "settings": { "foreground": "#d86840" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#22d3a8" } },
    { "scope": ["keyword.control", "keyword.operator.logical"], "settings": { "foreground": "#40e8b8" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#5ab8d8" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#5ab8d8" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"], "settings": { "foreground": "#9878d8" } },
    { "scope": ["entity.name.type.interface"], "settings": { "foreground": "#22d3a8" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#c8dcd0" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#b098e8" } },
    { "scope": ["variable.other.property", "variable.other.object.property"], "settings": { "foreground": "#8ab8a8" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#22d3a8" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#9878d8", "fontStyle": "italic" } },
    { "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"], "settings": { "foreground": "#00e8a0" } },
    { "scope": ["support.type.property-name.css"], "settings": { "foreground": "#5ab8d8" } },
    { "scope": ["variable.scss", "variable.css"], "settings": { "foreground": "#b098e8" } },
    { "scope": ["string.regexp"], "settings": { "foreground": "#d86840" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#22d3a8" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#3a5848" } },
    { "scope": ["support.type.property-name.json"], "settings": { "foreground": "#8ab8a8" } },
    { "scope": ["markup.heading", "entity.name.section.markdown"], "settings": { "foreground": "#00e8a0", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#d8ece4", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#b098e8", "fontStyle": "italic" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#5ab8d8" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#00e8a0" } },
    { "scope": ["punctuation.section.embedded.begin.php", "punctuation.section.embedded.end.php"], "settings": { "foreground": "#d86840" } },
    { "scope": ["variable.other.php"], "settings": { "foreground": "#b098e8" } },
    { "scope": ["entity.name.tag.yaml"], "settings": { "foreground": "#8ab8a8" } },
    { "scope": ["variable.language.this", "variable.language.self"], "settings": { "foreground": "#d86840", "fontStyle": "italic" } }
  ]
}

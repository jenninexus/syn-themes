    "list.highlightForeground": "#00e8a0",

    "statusBar.background": "#040807",
    "statusBar.foreground": "#00e8a0",
    "statusBar.border": "#081410",
    "statusBar.debuggingBackground": "#00e8a0",
    "statusBar.debuggingForeground": "#040807",
    "statusBar.noFolderBackground": "#040807",
    "statusBarItem.hoverBackground": "#00e8a022",
    "statusBarItem.remoteBackground": "#00e8a0",
    "statusBarItem.remoteForeground": "#040807",

    "panel.background": "#050908",
    "panel.border": "#102018",

    "gitDecoration.addedResourceForeground": "#00e8a0",
    "gitDecoration.modifiedResourceForeground": "#c8b030",
    "gitDecoration.deletedResourceForeground": "#d86040",
    "gitDecoration.untrackedResourceForeground": "#5ab8d8",
    "gitDecoration.ignoredResourceForeground": "#1e3028",
    "gitDecoration.conflictingResourceForeground": "#c8b030",

    "minimap.selectionHighlight": "#00e8a044",
    "minimap.findMatchHighlight": "#00e8a060",

    "peekView.border": "#00e8a044",
    "peekViewEditor.background": "#060b09",
    "peekViewResult.background": "#060b09",

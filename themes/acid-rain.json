    "button.secondaryForeground": "#c8dcd0",

    "badge.background": "#00e8a0",
    "badge.foreground": "#040807",

    "scrollbar.shadow": "#00000040",
    "scrollbarSlider.background": "#00e8a018",
    "scrollbarSlider.hoverBackground": "#00e8a030",
    "scrollbarSlider.activeBackground": "#00e8a044",

    "breadcrumb.foreground": "#5a8870",
    "breadcrumb.focusForeground": "#c8dcd0",

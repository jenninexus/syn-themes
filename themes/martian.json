{
  "name": "Martian",
  "type": "dark",
  "semanticHighlighting": true,
  "colors": {
    "foreground": "#f2ede8",
    "focusBorder": "#FF6B0044",
    "widget.shadow": "#00000070",
    "selection.background": "#FF6B0030",
    "descriptionForeground": "#c08050",
    "errorForeground": "#E53E3E",

    "titleBar.activeBackground": "#070504",
    "titleBar.activeForeground": "#FF6B00",
    "titleBar.inactiveBackground": "#070504",
    "titleBar.inactiveForeground": "#7a4828",

    "activityBar.background": "#070504",
    "activityBar.foreground": "#FF6B00",
    "activityBar.inactiveForeground": "#7a4828",
    "activityBar.border": "#120a06",
    "activityBarBadge.background": "#8B5CF6",
    "activityBarBadge.foreground": "#ffffff",

    "sideBar.background": "#0a0704",
    "sideBar.foreground": "#f2ede8",
    "sideBar.border": "#120a06",
    "sideBarTitle.foreground": "#FF6B00",
    "sideBarSectionHeader.background": "#0f0906",
    "sideBarSectionHeader.foreground": "#c08050",

    "editor.background": "#080604",
    "editor.foreground": "#f2ede8",
    "editor.lineHighlightBackground": "#14100808",
    "editor.selectionBackground": "#FF6B0025",
    "editor.inactiveSelectionBackground": "#FF6B0012",
    "editor.findMatchBackground": "#FFAA0030",
    "editor.findMatchHighlightBackground": "#FFAA0018",
    "editor.wordHighlightBackground": "#8B5CF618",
    "editorCursor.foreground": "#FFAA00",
    "editorWhitespace.foreground": "#1a1008",
    "editorIndentGuide.background1": "#160c06",
    "editorIndentGuide.activeBackground1": "#281808",
    "editorLineNumber.foreground": "#3a2010",
    "editorLineNumber.activeForeground": "#a05828",
    "editorBracketMatch.background": "#8B5CF618",
    "editorBracketMatch.border": "#8B5CF644",
    "editorGutter.addedBackground": "#42f4c866",
    "editorGutter.modifiedBackground": "#FF6B0066",
    "editorGutter.deletedBackground": "#E53E3E66",
    "editorOverviewRuler.border": "#120a06",

    "editorGroupHeader.tabsBackground": "#070504",
    "editorGroupHeader.tabsBorder": "#120a06",
    "tab.activeBackground": "#0f0906",
    "tab.activeForeground": "#f2ede8",
    "tab.activeBorderTop": "#FF6B00",
    "tab.inactiveBackground": "#070504",
    "tab.inactiveForeground": "#7a4828",
    "tab.border": "#120a06",
    "tab.hoverBackground": "#120a06",

    "list.activeSelectionBackground": "#FF6B0018",
    "list.activeSelectionForeground": "#f2ede8",
    "list.inactiveSelectionBackground": "#FF6B000c",
    "list.hoverBackground": "#0f0906",
    "list.focusBackground": "#FF6B0015",
    "list.highlightForeground": "#FFAA00",

    "statusBar.background": "#070504",
    "statusBar.foreground": "#FF6B00",
    "statusBar.border": "#120a06",
    "statusBar.debuggingBackground": "#E53E3E",
    "statusBar.debuggingForeground": "#ffffff",
    "statusBar.noFolderBackground": "#070504",
    "statusBarItem.hoverBackground": "#FF6B0018",
    "statusBarItem.remoteBackground": "#8B5CF6",
    "statusBarItem.remoteForeground": "#ffffff",

    "panel.background": "#080604",
    "panel.border": "#1a0e06",
    "panelTitle.activeBorder": "#FF6B00",
    "panelTitle.activeForeground": "#f2ede8",
    "panelTitle.inactiveForeground": "#7a4828",

    "terminal.background": "#070504",
    "terminal.foreground": "#f2ede8",
    "terminal.ansiBlack": "#1a1008",
    "terminal.ansiRed": "#E53E3E",
    "terminal.ansiGreen": "#42f4c8",
    "terminal.ansiYellow": "#FFAA00",
    "terminal.ansiBlue": "#63B3ED",
    "terminal.ansiMagenta": "#8B5CF6",
    "terminal.ansiCyan": "#42f4c8",
    "terminal.ansiWhite": "#f2ede8",
    "terminal.ansiBrightBlack": "#3a2010",
    "terminal.ansiBrightRed": "#ff5c5c",
    "terminal.ansiBrightGreen": "#6afce0",
    "terminal.ansiBrightYellow": "#ffc840",
    "terminal.ansiBrightBlue": "#88ccff",
    "terminal.ansiBrightMagenta": "#A855F7",
    "terminal.ansiBrightCyan": "#6afce0",
    "terminal.ansiBrightWhite": "#fff8f0",
    "terminalCursor.foreground": "#FFAA00",

    "input.background": "#0f0906",
    "input.foreground": "#f2ede8",
    "input.border": "#1a0e06",
    "input.placeholderForeground": "#7a4828",
    "inputOption.activeBorder": "#FF6B00",

    "dropdown.background": "#0f0906",
    "dropdown.foreground": "#f2ede8",
    "dropdown.border": "#1a0e06",

    "button.background": "#FF6B00",
    "button.foreground": "#080604",
    "button.hoverBackground": "#FF7F32",
    "button.secondaryBackground": "#1a0e06",
    "button.secondaryForeground": "#f2ede8",

    "badge.background": "#8B5CF6",
    "badge.foreground": "#ffffff",

    "scrollbar.shadow": "#00000060",
    "scrollbarSlider.background": "#FF6B0015",
    "scrollbarSlider.hoverBackground": "#FF6B0028",
    "scrollbarSlider.activeBackground": "#FF6B003c",

    "breadcrumb.foreground": "#7a4828",
    "breadcrumb.focusForeground": "#f2ede8",
    "breadcrumb.activeSelectionForeground": "#FF6B00",
    "breadcrumbPicker.background": "#0f0906",

    "gitDecoration.addedResourceForeground": "#42f4c8",
    "gitDecoration.modifiedResourceForeground": "#FF6B00",
    "gitDecoration.deletedResourceForeground": "#E53E3E",
    "gitDecoration.untrackedResourceForeground": "#63B3ED",
    "gitDecoration.ignoredResourceForeground": "#2a1808",
    "gitDecoration.conflictingResourceForeground": "#FFAA00",

    "minimap.selectionHighlight": "#FF6B0030",
    "minimap.findMatchHighlight": "#FFAA0040",

    "peekView.border": "#8B5CF644",
    "peekViewEditor.background": "#0a0704",
    "peekViewResult.background": "#0a0704",
    "peekViewTitle.background": "#0f0906",

    "notifications.background": "#0f0906",
    "notifications.foreground": "#f2ede8",
    "notifications.border": "#1a0e06"
  },
  "semanticTokenColors": {
    "function.declaration": "#63B3ED",
    "function.defaultLibrary": "#42f4c8aa",
    "variable.readonly": "#e8d8c8",
    "variable.defaultLibrary": "#FFAA00",
    "property.readonly": "#c08878",
    "type.defaultLibrary": "#FFAA00",
    "class": "#8B5CF6",
    "interface": "#42f4c8",
    "enum": "#8B5CF6",
    "enumMember": "#FF3D00",
    "namespace": "#FF6B00",
    "decorator": "#FFAA00",
    "parameter.declaration": "#A855F7",
    "typeParameter": "#42f4c8",
    "*.modification": { "fontStyle": "underline" },
    "*.async": { "fontStyle": "italic" },
    "variable.readonly.defaultLibrary": "#FFAA00"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5a3820", "fontStyle": "italic" } },
    { "scope": ["string", "string.quoted"], "settings": { "foreground": "#42f4c8" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#FFAA00" } },
    { "scope": ["constant.language", "constant.other"], "settings": { "foreground": "#FF3D00" } },
    { "scope": ["keyword", "storage.type", "storage.modifier"], "settings": { "foreground": "#FF6B00" } },
    { "scope": ["keyword.control", "keyword.operator.logical"], "settings": { "foreground": "#FF7F32" } },
    { "scope": ["keyword.operator"], "settings": { "foreground": "#c08878" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call"], "settings": { "foreground": "#63B3ED" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.class", "support.type"], "settings": { "foreground": "#8B5CF6" } },
    { "scope": ["entity.name.type.interface"], "settings": { "foreground": "#42f4c8" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#f2ede8" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#A855F7" } },
    { "scope": ["variable.other.property", "variable.other.object.property"], "settings": { "foreground": "#c08878" } },
    { "scope": ["entity.name.tag"], "settings": { "foreground": "#FF6B00" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#8B5CF6", "fontStyle": "italic" } },
    { "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css"], "settings": { "foreground": "#42f4c8" } },
    { "scope": ["support.type.property-name.css"], "settings": { "foreground": "#63B3ED" } },
    { "scope": ["variable.scss", "variable.css"], "settings": { "foreground": "#A855F7" } },
    { "scope": ["string.regexp"], "settings": { "foreground": "#FF3D00" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#FFAA00" } },
    { "scope": ["punctuation"], "settings": { "foreground": "#5a3820" } },
    { "scope": ["support.type.property-name.json"], "settings": { "foreground": "#c08878" } },
    { "scope": ["markup.heading", "entity.name.section.markdown"], "settings": { "foreground": "#FF6B00", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#f2ede8", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#A855F7", "fontStyle": "italic" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#63B3ED" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#42f4c8" } },
    { "scope": ["punctuation.section.embedded.begin.php", "punctuation.section.embedded.end.php"], "settings": { "foreground": "#FF6B00" } },
    { "scope": ["variable.other.php"], "settings": { "foreground": "#A855F7" } },
    { "scope": ["entity.name.tag.yaml"], "settings": { "foreground": "#c08878" } },
    { "scope": ["variable.language.this", "variable.language.self"], "settings": { "foreground": "#FF3D00", "fontStyle": "italic" } }
  ]
}

  "semanticTokenColors": {
    "function.declaration": "#f090c0",
    "function.defaultLibrary": "#d878b0aa",
    "variable.readonly": "#c8b0e0",
    "variable.defaultLibrary": "#d8c050",
    "property.readonly": "#d878b0",
    "type.defaultLibrary": "#d8c050",
    "class": "#f090c0",
    "interface": "#70c8e8",
    "enum": "#f090c0",
    "enumMember": "#f07070",
    "namespace": "#f058b0",
    "decorator": "#d8c050",
    "parameter.declaration": "#f090c0",
    "typeParameter": "#70c8e8",
    "*.modification": {
      "fontStyle": "underline"
    },
    "*.async": {
      "fontStyle": "italic"
    },
    "variable.readonly.defaultLibrary": "#d8c050"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8b7f9b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted"
      ],
      "settings": {
        "foreground": "#68c8a0"
      }
    },
    {
      "scope": [
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#d8c050"
      }
    },
    {
      "scope": [
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#f07070"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#f058b0"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.operator.logical"
      ],
      "settings": {
        "foreground": "#f888c0"
      }
    },
    {
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#70c8e8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#f090c0"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#f090c0"
      }
    },
    {
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#70c8e8"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other"
      ],
      "settings": {
        "foreground": "#dcc8e8"
      }
    },
    {
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#f090c0"
      }
    },
    {
      "scope": [
        "variable.other.property",
        "variable.other.object.property"
      ],
      "settings": {
        "foreground": "#d878b0"
      }
    },
    {
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#f058b0"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#f07070",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#f058b0"
      }
    },
    {
      "scope": [
        "support.type.property-name.css"
      ],
      "settings": {
        "foreground": "#d878b0"
      }
    },
    {
      "scope": [
        "variable.scss",
        "variable.css"
      ],
      "settings": {
        "foreground": "#f090c0"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#e84848"
      }
    },
    {
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#70c8e8"
      }
    },
    {
      "scope": [
        "punctuation"
      ],
      "settings": {
        "foreground": "#86779d"
      }
    },
    {
      "scope": [
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#d878b0"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section.markdown"
      ],
      "settings": {
        "foreground": "#f058b0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#ead8f0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#f090c0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#70c8e8"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#68c8a0"
      }
    },
    {
      "scope": [
        "punctuation.section.embedded.begin.php",
        "punctuation.section.embedded.end.php"
      ],
      "settings": {
        "foreground": "#e84848"
      }
    },
    {
      "scope": [
        "variable.other.php"
      ],
      "settings": {
        "foreground": "#f090c0"
      }
    },
    {
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#d878b0"
      }
    },
    {
      "scope": [
        "variable.language.this",
        "variable.language.self"
      ],
      "settings": {
        "foreground": "#f07070",
        "fontStyle": "italic"
      }
    }
  ]
}

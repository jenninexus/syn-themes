{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Package Extension",
      "type": "shell",
      "command": "npx @vscode/vsce package --no-dependencies",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Publish Extension",
      "type": "shell",
      "command": "npx @vscode/vsce publish --pat $env:VSCE_PAT",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "dependsOn": "Package Extension"
    },
    {
      "label": "Publish Open VSX",
      "type": "shell",
      "command": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/publish-openvsx.ps1",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" },
      "dependsOn": "Package Extension"
    },
    {
      "label": "Publish Both (VS Code + Open VSX)",
      "dependsOrder": "sequence",
      "dependsOn": ["Publish Extension", "Publish Open VSX"],
      "problemMatcher": []
    },
    {
      "label": "Capture Screenshots",
      "type": "shell",
      "command": "node storage/tools/capture-v3-screenshots.mjs",
      "group": "test",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    },
    {
      "label": "Generate Swatches",
      "type": "shell",
      "command": "node storage/tools/generate-swatches.mjs",
      "group": "build",
      "problemMatcher": [],
      "presentation": { "reveal": "always", "panel": "shared" }
    }
  ]
}
